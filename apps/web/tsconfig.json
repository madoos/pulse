{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "@testing-library/jest-dom/vitest"],
    "paths": {
      "@app/*": ["./src/app/*"],
      "@advisory-firms/*": ["./src/advisory-firms/*"],
      "@advisory-firm-detail/*": ["./src/advisory-firm-detail/*"],
      "@shared/*": ["./src/shared/*"],
      "@login/*": ["./src/login/*"],
      "@network-overview/*": ["./src/network-overview/*"],
      "@session/*": ["./src/session/*"],
      "@support-assistant/*": ["./src/support-assistant/*"],
      "@system-status/*": ["./src/system-status/*"]
    }
  },
  "include": ["src", "*.config.ts", "vitest.setup.ts"]
}
